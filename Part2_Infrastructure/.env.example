# ─────────────────────────────────────────────────────────────────────────────
# AlphaEngine Trading Automation — configuration.
# Copy to `.env`. Every value below is optional; the system runs with sensible
# defaults and no .env file at all.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
# Stable public https origin, used only for Telegram webhook delivery. Do not
# expose a temporary unauthenticated tunnel; use polling for local development.
PUBLIC_URL=

# ── Market data (Module A) ───────────────────────────────────────────────────
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
VENUES=BINANCE,BYBIT
BOOK_DEPTH=50
PROBE_NOTIONAL_USD=100000
ENABLE_MARKET_DATA=1
# Explicit demo mode: generate a clearly tagged synthetic book if every venue
# feed is unreachable. Keep off for production and ordinary local runs.
ALLOW_SYNTHETIC_BOOK=0
TCA_SNAPSHOT_INTERVAL_S=15

# ── Risk limits (Module B) — changing these is a deploy, by design ───────────
MAX_ORDER_NOTIONAL_USD=50000
MAX_GROSS_EXPOSURE_USD=500000
MAX_SYMBOL_NOTIONAL_USD=150000
MAX_ORDERS_PER_SEC=5
RATE_LIMIT_BURST=10
MAX_DAILY_DRAWDOWN_PCT=0.05
MAX_PRICE_DEVIATION_BPS=500
MAX_EST_SLIPPAGE_BPS=75
STARTING_EQUITY_USD=1000000
# Taker fee, charged when an order crosses the spread.
PAPER_FEE_BPS=4
# MARKET equity paper fills use a server-verified quote plus this explicit
# execution-cost assumption. They never claim exchange L2 routing.
PAPER_EQUITY_SLIPPAGE_BPS=8
# Maximum age of a trusted equity quote; seven days covers a long weekend.
PAPER_EQUITY_QUOTE_MAX_AGE_S=604800
# Optional validated quote facade used for authenticated clients that do not
# yet attach paper_execution. Empty keeps all unknown symbols fail-closed.
PAPER_EQUITY_QUOTE_URL=
PAPER_EQUITY_QUOTE_TIMEOUT_S=5
# Maker fee, charged when a resting order is filled by someone crossing to it.
# Lower than the taker fee on purpose — charging a resting fill the taker rate
# would report a cost the desk did not pay.
PAPER_MAKER_FEE_BPS=1
# How often the resting book is checked against the consolidated touch.
WORKING_ORDER_SWEEP_S=1.0
# Ceiling on the resting book itself: an algo that places and never cancels is
# unbounded memory and an unbounded sweep.
MAX_WORKING_ORDERS=200

# ── Backtester (Module C) ────────────────────────────────────────────────────
BACKTEST_MAX_COMBOS=400
BACKTEST_FEE_BPS=6
BACKTEST_SLIPPAGE_BPS=2
WALK_FORWARD_FOLDS=4
JOB_WORKERS=2
# Set to switch the job queue from the in-process pool to Celery.
# REDIS_URL=redis://localhost:6379/0

# ── Data ops: the quality ledger, the work queue, replay and backfill ────────
# Every value here has a default that works; nothing needs setting to run.
# The ledger, the work queue and the schedule state share ONE SQLite file on the
# same volume as the audit database. It is deliberately not the DuckDB audit
# store: those writes are fire-and-forget by design, which is wrong for a PATCH
# that must answer 409 honestly.
# DATA_OPS_DB_PATH=./data/data_ops.sqlite
#
# Where the eight data-operations tables live: "sqlite" (default) or "postgres".
#
# "postgres" needs SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and
# SUPABASE_DESK_ID, plus the migrations applied —
# supabase/apply_all.generated.sql, or `supabase db push`. It is refused rather
# than silently downgraded if any is missing.
#
# What it moves: quality findings, escalations, schedule runs, work items and
# all four Diffusion ledgers stop being local to one container's filesystem.
# What it does NOT move: the position book, the resting-order book, the token
# bucket and the kill switch are still process-local mutable state, so this is
# still ONE gateway process. tests/test_container_contract.py fails the build
# on --workers, by design.
# DATA_OPS_BACKEND=sqlite
# How long contract findings are kept (1-90), the window the merged view
# summarises, and how many recent rows it carries.
# DATA_QUALITY_RETENTION_DAYS=7
# DATA_QUALITY_VIEW_WINDOW_MINUTES=1440
# DATA_QUALITY_RECENT_LIMIT=25
# Escalation rule 1: this many payloads with a fatal finding from one provider
# inside the window. Rule 2: a contract-fail rate above the fraction, once at
# least this many payloads were evaluated. One escalation per rule and provider
# per cooldown; it resolves itself when the condition clears. Telegram carries
# it when the bot is configured, the log and the audit trail always do.
# DATA_QUALITY_ESCALATE_FATAL_COUNT=3
# DATA_QUALITY_ESCALATE_WINDOW_MINUTES=15
# DATA_QUALITY_ESCALATE_FAIL_RATE=0.25
# DATA_QUALITY_ESCALATE_MIN_SAMPLES=8
# DATA_QUALITY_ESCALATE_COOLDOWN_MINUTES=60
# A replay re-runs one capability through the WEB workspace's own validated fetch
# path, because the adapters, the keys and the contracts live only there. Unset,
# it falls back to the origin of PAPER_EQUITY_QUOTE_URL, and a replay refuses
# with a message naming this variable when neither is set.
# WEB_WORKSPACE_URL=https://alphaengine-workspace.vercel.app
# DATA_JOB_TIMEOUT_S=20
# DATA_BACKFILL_MAX_BARS=20000
# Semicolon-separated cadence entries. Empty means nothing is scheduled — the
# routes still work on demand. Invalid entries are listed with their error rather
# than dropped silently.
#   replay:<capability>:<SYMBOL>@every=15m|1h|6h|1d
#   backfill:<SYMBOL>:<interval>:<lookback>@daily=HH:MM
# e.g. DATA_SCHEDULES=replay:quote:BTCUSDT@every=1h;backfill:BTCUSDT:1h:30d@daily=02:15
# DATA_SCHEDULES=
# DATA_SCHEDULER_TICK_S=30

# ── Telegram ─────────────────────────────────────────────────────────────────
# From @BotFather. Leave empty to run the gateway and web workspace without the
# independent text-only notification companion. Never commit this value.
TELEGRAM_BOT_TOKEN=
# auto | webhook | polling | send-only.  auto = webhook if PUBLIC_URL is https,
# else polling. send-only sends alerts and never consumes updates: use it on a
# laptop running beside the deployed gateway, because two long-pollers on one
# token take turns being refused (409 Conflict) and both report degraded.
TELEGRAM_MODE=auto
# Required in webhook mode: unique, random, and at least 32 characters.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram USER ids allowed to read operational data. Empty is
# fail-closed (bootstrap commands only). Message /whoami to get yours.
TELEGRAM_ALLOWED_USER_IDS=


# ─────────────────────────────────────────────────────────────────────────────
# Operators permitted to CHANGE risk state from Telegram: /halt, /resume,
# /flatten. Comma-separated user IDs.
#
# Deliberately a SECOND, narrower list than TELEGRAM_ALLOWED_USER_IDS above,
# and empty by default. The two answer different questions: being on the read
# list means "you may see this book", being here means "you may stop the desk".
# If they were one list, every analyst added for /portfolio would silently gain
# a kill switch.
#
# Each command additionally requires a single-use confirmation code, bound to
# the requesting user and expiring in 90 seconds, so a forwarded message cannot
# fire one. /flatten submits through the same pre-trade gates as a manual order.
TELEGRAM_CONTROL_USER_IDS=
# Destination chat ids for centrally managed pushed alerts. Each destination
# still needs an allow-listed user to run /subscribe once, which records the
# current authorised owner and prevents legacy rows bypassing revocation.
TELEGRAM_ALERT_CHAT_IDS=

# Shared secret that signs the one-time Connect token, so the web app can mint
# a link the bot can verify without a round trip. THE SAME VALUE MUST BE SET ON
# THE GATEWAY AND ON VERCEL — the minter and the verifier are different
# processes on different hosts. Never prefix it NEXT_PUBLIC_: that would inline
# it into the browser bundle and let anyone forge a binding. 32+ random chars.
# Unset is fail-closed: the Connect control renders a refusal that names the
# missing secret rather than a link that cannot complete.
TELEGRAM_LINK_SECRET=
# How long a minted Connect token stays valid, in seconds. Short on purpose —
# it only has to survive the walk from the button to the Telegram app.
TELEGRAM_LINK_TOKEN_TTL_S=900
# How long a GUEST binding lasts, in seconds. A guest desk pass is a browser
# session cookie the gateway cannot watch expire, so the grant carries its own
# clock instead of being unbounded and unrevocable. Accounts do not use this;
# their binding ends with the account.
TELEGRAM_GUEST_LINK_TTL_S=43200

# ── Web UI auth ──────────────────────────────────────────────────────────────
# Generate a long random token for any public gateway. Use the same value as
# ALPHAENGINE_GATEWAY_TOKEN in the Vercel web project. OpenBB uses a separate
# OPENBB_API_TOKEN so market-data and portfolio access never share credentials.
WEB_API_TOKEN=replace-with-a-long-random-token
# 1 = reject unauthenticated portfolio, research and order API calls. Keep 0
# only for local development on a private interface.
REQUIRE_AUTH=1

# ── Supabase mirror + RAG (optional; off by default) ─────────────────────────
# DuckDB stays authoritative. With these unset every Supabase code path is a
# no-op. The service-role key belongs ONLY here (gateway env) — never on
# Vercel, never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MIRROR_ENABLED=0
RESEARCH_RAG_ENABLED=0
# SUPABASE_DESK_ID=00000000-0000-0000-0000-000000000001
# Keep 0 until migration 20260831130000 has reached the live Supabase project.
# Then 1 scopes /search, /ask and graph traversal to SUPABASE_DESK_ID; a route
# that cannot carry the scope refuses instead of serving another desk's rows.
# RESEARCH_SCOPE_TO_DESK=0
# SUPABASE_TIMEOUT_S=5.0
# SUPABASE_MIRROR_QUEUE_MAX=1000
# Long quantitative documents are split deterministically before embedding;
# chart documents remain whole so their durable image row IDs stay stable.
# RESEARCH_CHUNK_MAX_CHARS=2400
# RESEARCH_CHUNK_OVERLAP_CHARS=240
# Retrieval results are cached per process and keyed by desk (tenant), query,
# kind, and result count. Stale entries are used only for upstream failures.
# RESEARCH_RETRIEVAL_CACHE_MAX=256
# RESEARCH_RETRIEVAL_CACHE_TTL_S=30
# RESEARCH_RETRIEVAL_CACHE_STALE_TTL_S=300

# ── Neo4j graph projection (optional; off by default) ────────────────────────
# A rebuildable READ MODEL of research_edges — Postgres stays authoritative,
# the 6h reconcile sweep MERGEs the same derived edges here, and a divergence
# is fixed by dropping the graph and re-projecting. With NEO4J_URI unset every
# graph code path reports "not configured" and moves on.
#
# Paste the values from Aura's downloaded credentials file VERBATIM. On the
# current Aura generation ("Cypher 25" instances) the username and database are
# the INSTANCE ID, not the literal "neo4j" — older instances and self-hosted
# servers use "neo4j" for both. Trust the file over folklore: it is generated
# by the instance that will be checking the credentials.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ── Stage-5 generation + stage-3 re-ranking (optional; off by default) ───────
# With GEMINI_API_KEY unset every generation report says verdict=refused with
# the reason, and the desk is exactly the desk it was. The model is fenced:
# never called below the CRAG refuse band, every claim must cite a supplied
# document id, and "the corpus does not say" is a correct answer. The test
# suite blanks this key by ASSIGNMENT in tests/conftest.py, so tests can never
# spend quota whatever the shell exports.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# RERANK_MODEL_PATH points at local BGE cross-encoder ONNX weights
# (pip install -r requirements-rerank.txt). Unset, RRF order stands.
RERANK_MODEL_PATH=

# ── Coherence engine (Kalshi) ────────────────────────────────────────────────
# The engine reads Kalshi's PUBLIC endpoints and needs no API key for any of it:
# markets, events, series, orderbooks, trades, fee feeds and exchange status are
# all served without one. Leave every variable below unset and the tab still
# works — it simply does not record.
#
# API roots are validated at startup: HTTP(S), no embedded credentials/query/
# fragment, and exactly the /trade-api/v2 path. Production reads fail over only
# to production; signed demo reads fail over only to demo.
KALSHI_PUBLIC_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_PUBLIC_FAILOVER_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_DEMO_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_DEMO_FAILOVER_URL=https://demo-api.kalshi.co/trade-api/v2

# COHERENCE_SERIES turns the recorder on. Comma-separated series tickers; empty
# means the recorder has nothing to do and says so rather than inventing a
# universe. Names are upper-cased, validated and de-duplicated at startup.
# COHERENCE_POLL_S=0 (the default) keeps it off even with a watchlist: a process
# that starts reaching for an exchange the moment it boots is not something to
# enable by accident. COHERENCE_MAX_EVENTS bounds each series harvest.
COHERENCE_SERIES=
COHERENCE_POLL_S=0
COHERENCE_MAX_EVENTS=2
# Shell is on-demand and must see the complete namespace; this cap is separate from persisted harvesting.
COHERENCE_SHELL_MAX_EVENTS=50

# COHERENCE_CALIBRATION_EVERY_S is the scoring cadence, in seconds, and it is off
# at 0. When set, the recorder harvests settled markets for every watched series
# and records one settled score on that cadence — the Scorecard's time axis.
# Nothing settles in five minutes, so this is its own clock rather than the
# book poll's. One settled-markets read per watched series per cadence; at 900
# that is two reads a quarter-hour against a bucket refilling at 50 a second.
# Undocumented here until 2026-08-26, and absent from the OCI deploy for the
# same week — which is why the deployed corpus never filled.
COHERENCE_CALIBRATION_EVERY_S=0

# COHERENCE_WARM_S precomputes the reads the desk asks for, so a request never
# waits on the exchange. Zero (the default) keeps it off, for the same reason
# COHERENCE_POLL_S is: a fresh clone with no keys must not start reaching for a
# venue on boot. It also needs COHERENCE_SERIES.
#
# THE TRADE, stated because the desk has to show it: reads answer in
# milliseconds and the data is as fresh as this cadence, NEVER fresher. The age
# pill reads the snapshot's own age, so what a reader sees is the age of the
# book rather than the age of their request.
#
# What it costs someone else: at 20s this process makes roughly seventeen Kalshi
# calls every twenty seconds instead of ten every five minutes. That is still
# about a fifth of the self-imposed read budget, but it is a real change in what
# this engine does to an exchange's infrastructure, and worth choosing rather
# than discovering.
COHERENCE_WARM_S=0

# How long a precomputed answer stays worth serving. Zero means three times the
# cadence — long enough that one missed pass does not send every read back to
# the venue, short enough that a refresher which died an hour ago stops
# answering with an hour-old ladder.
COHERENCE_WARM_MAX_AGE_S=0

# Kalshi publishes token buckets per ACCOUNT and none at all for the keyless
# traffic this engine uses. 50 tokens/second is a quarter of the smallest
# published tier — about five requests a second — because guessing high on
# someone else's infrastructure is not our risk to take.
COHERENCE_READ_TOKENS_PER_S=50
COHERENCE_READ_BURST_TOKENS=100
COHERENCE_DEFAULT_TOKEN_COST=10
COHERENCE_REQUEST_TIMEOUT_S=20

# Fee metadata changes much more slowly than books. Cache venue fee documents
# for an hour; prices and event observations are not covered by this TTL.
COHERENCE_FEE_META_TTL_S=3600

# Published fee hypotheses. Series multipliers and event overrides are applied
# later, and observed fills replace estimates once the desk has them.
COHERENCE_TAKER_RATE=0.07
COHERENCE_MAKER_RATIO=0.25
COHERENCE_COMBO_MAKER_RATIO=0.5

# $0.01 for an ordinary account, $0.0001 for a direct member. This one knob is
# worth a hundredfold on the rounding fee, which is the fee component nobody
# models and the one that can exceed the notional on a small clip.
COHERENCE_BALANCE_PRECISION=0.01

# Kalshi pays interest on cash and open positions, but the API does not publish
# the rate — it lives in a help-centre article and it is variable. Unset means
# carry is left OUT of every estimate and the surface says it was left out;
# setting it puts a number you sourced into the sum rather than one we invented.
COHERENCE_CARRY_APY=

# Empty stores coherence.duckdb beneath DATA_DIR. The engine only renders an
# order plan; dry-run remains explicit even though this release has no send path.
COHERENCE_DB_PATH=
COHERENCE_DRY_RUN=1

# Signed reads, for the few endpoints that need a key (GET /account/limits, and
# the demo portfolio surface). Generate a SANDBOX key pair at demo.kalshi.co —
# it is a separate account from production and cannot sign a production request,
# which is why the client keeps the two hosts apart.
#
# Generate the pair on Kalshi's site and save the private key at the ignored
# path below. A Python gateway launched on the host resolves this path from
# Part2_Infrastructure, not from its process working directory.
#
# Ordinary Docker Compose startup remains keyless. The opt-in Kalshi override
# copies this same host file into a private volume and replaces the value inside
# the container with /run/secrets/kalshi-demo-private-key.pem; see SETUP.md.
# Never rename either variable with a NEXT_PUBLIC_ prefix: that would expose
# credential configuration to the browser bundle.
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=secrets/kalshi-demo-private-key.pem
