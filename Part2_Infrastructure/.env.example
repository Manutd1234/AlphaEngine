# ─────────────────────────────────────────────────────────────────────────────
# AlphaEngine Trading Automation — configuration.
# Copy to `.env`. Every value below is optional; the system runs with sensible
# defaults and no .env file at all.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
# Public https origin. Required for Telegram webhooks and the Mini App button.
# Free tunnel, no account needed:
#   cloudflared tunnel --url http://localhost:8000
# then paste the https://<name>.trycloudflare.com URL here and restart.
PUBLIC_URL=

# The Vercel strategy-research portal, linked from /start and /research.
RESEARCH_PORTAL_URL=

# ── Market data (Module A) ───────────────────────────────────────────────────
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
VENUES=BINANCE,BYBIT
BOOK_DEPTH=50
PROBE_NOTIONAL_USD=100000
ENABLE_MARKET_DATA=1
# Generate a clearly-tagged synthetic book if every venue feed is unreachable.
ALLOW_SYNTHETIC_BOOK=1
TCA_SNAPSHOT_INTERVAL_S=15

# ── Risk limits (Module B) — changing these is a deploy, by design ───────────
MAX_ORDER_NOTIONAL_USD=50000
MAX_GROSS_EXPOSURE_USD=500000
MAX_SYMBOL_NOTIONAL_USD=150000
MAX_ORDERS_PER_SEC=5
RATE_LIMIT_BURST=10
MAX_DAILY_DRAWDOWN_PCT=0.05
MAX_PRICE_DEVIATION_BPS=500
MAX_EST_SLIPPAGE_BPS=75
STARTING_EQUITY_USD=1000000
PAPER_FEE_BPS=4

# ── Backtester (Module C) ────────────────────────────────────────────────────
BACKTEST_MAX_COMBOS=400
BACKTEST_FEE_BPS=6
BACKTEST_SLIPPAGE_BPS=2
WALK_FORWARD_FOLDS=4
JOB_WORKERS=2
# Set to switch the job queue from the in-process pool to Celery.
# REDIS_URL=redis://localhost:6379/0

# ── Telegram ─────────────────────────────────────────────────────────────────
# From @BotFather. Leave empty to run REST + web portal only.
TELEGRAM_BOT_TOKEN=
# auto | webhook | polling.  auto = webhook if PUBLIC_URL is https, else polling.
TELEGRAM_MODE=auto
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Comma-separated chat ids allowed to issue commands. Empty = open (dev only).
# Get yours by messaging the bot /whoami.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALERT_CHAT_IDS=

# ── Web UI auth ──────────────────────────────────────────────────────────────
# Generate a long random token for any public gateway. Use the same value as
# ALPHAENGINE_GATEWAY_TOKEN (or OPENBB_API_TOKEN) in the Vercel project.
WEB_API_TOKEN=replace-with-a-long-random-token
# 1 = reject unauthenticated portfolio, research and order API calls. Keep 0
# only for local development on a private interface.
REQUIRE_AUTH=1
