# Anchored (leading /) on purpose: a bare `data/` matches at ANY depth and would
# silently swallow a real package such as modules/data/ or tests/data/.
# secrets — never commit; .env.example is the template
.env
/secrets/

# runtime artefacts (recreated on startup)
/data/*
!/data/.gitkeep
*.duckdb
*.duckdb.wal
*.sqlite
# Some in-memory integration paths emit this transient session sentinel in the
# process working directory; it is runtime state, never repository content.
/:memory:.ses

# python
/venv/
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# os
.DS_Store
